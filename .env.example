# OPENROUTER_API_KEY: Required for OpenRouter AI API calls
# On Vercel: Add in Project Settings -> Environment Variables
# **NEVER commit the actual API key to Git**
OPENROUTER_API_KEY=

# OPENROUTER_MODEL: Optional override for model (default: google/gemini-2.5-flash)
# See available models at https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.5-flash

# NODE_ENV: Environment (development or production, set by Vercel automatically)
# NODE_ENV=production
