# GEMINI_API_KEY: Required for Gemini AI API calls
# On Vercel: Add in Project Settings -> Environment Variables
# **NEVER commit the actual API key to Git**
GEMINI_API_KEY=

# GEMINI_MODEL: Optional override for Gemini model version (default: gemini-3.7-flash)
# GEMINI_MODEL=gemini-3.7-flash

# NODE_ENV: Environment (development or production, set by Vercel automatically)
# NODE_ENV=production
