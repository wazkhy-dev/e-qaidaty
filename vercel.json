{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci --omit=dev",
  "rewrites": [
    {
      "source": "/((?!api|_next|_static|.*\\..*|$).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "src/**/*"
    }
  }
}
